# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Optional: public site URL for sitemap / OG / auth redirects
NEXT_PUBLIC_SITE_URL=https://autoshabani.com

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Service role for privileged server tasks (orders, AI catalogue with hidden_references,
# embeddings, search feedback). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: webhook for callback form (Formspark / Make / Zapier / Resend proxy)
CALLBACK_WEBHOOK_URL=

# Optional: order notification webhook (falls back to CALLBACK_WEBHOOK_URL)
ORDER_WEBHOOK_URL=

# Optional: Resend transactional email for order lifecycle notices
RESEND_API_KEY=
ORDER_FROM_EMAIL=AUTO SHABANI <orders@autoshabani.com>

# Optional: Stripe for online checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Preferred: Vercel AI Gateway for catalogue AI search + embeddings (server-only).
# Create a key in Vercel → AI Gateway → API Keys (not `npx vercel ai-gateway setup` —
# that CLI is only for local coding agents, not the website).
AI_GATEWAY_API_KEY=
OPENAI_SEARCH_MODEL=openai/gpt-4o-mini
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Fallback: direct OpenAI if you are not using the Gateway
# OPENAI_API_KEY=
# OPENAI_SEARCH_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: shared secret for POST /api/ai/reindex and GET /api/ai/learning
REINDEX_SECRET=

# Optional: extra search synonym groups as JSON array of string arrays
# SEARCH_SYNONYMS_JSON=[["feroda","brake pads","pllakat e frenave"]]
