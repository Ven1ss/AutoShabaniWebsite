# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Optional: public site URL for sitemap / OG / auth redirects
NEXT_PUBLIC_SITE_URL=https://autoshabani.com

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: service role for privileged server tasks (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: webhook for callback form (Formspark / Make / Zapier / Resend proxy)
CALLBACK_WEBHOOK_URL=

# Optional: order notification webhook (falls back to CALLBACK_WEBHOOK_URL)
ORDER_WEBHOOK_URL=

# Optional: Resend transactional email for order lifecycle notices
RESEND_API_KEY=
ORDER_FROM_EMAIL=AUTO SHABANI <orders@autoshabani.com>

# Optional: Stripe for online checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: AI for catalogue search + homepage "SHABANI AI" finder (server-only).
# Without this key the finder still works via hybrid search + template intros.
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-4o-mini

# Optional: extra search synonym groups as JSON array of string arrays
# SEARCH_SYNONYMS_JSON=[["feroda","brake pads","pllakat e frenave"]]
